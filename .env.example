# X API Credentials
# Get these from https://developer.x.com/en/portal/dashboard
# Or run: node src/index.js setup
X_BEARER_TOKEN=your_bearer_token_here

# Stream Configuration (optional)
# Backfill minutes (0-5, Enterprise only)
# When reconnecting, request Posts matched during the disconnection period
STREAM_BACKFILL_MINUTES=0

# Tweet fields to include (comma-separated)
# Options: attachments,author_id,context_annotations,conversation_id,created_at,
#          edit_controls,entities,geo,id,in_reply_to_user_id,lang,
#          possibly_sensitive,public_metrics,referenced_tweets,reply_settings,
#          source,text,withheld
STREAM_TWEET_FIELDS=author_id,created_at,lang,public_metrics,entities,source

# Expansions to include (comma-separated)
# Options: attachments.poll_ids,attachments.media_keys,author_id,
#          edit_history_tweet_ids,entities.mentions.username,geo.place_id,
#          in_reply_to_user_id,referenced_tweets.id,referenced_tweets.id.author_id
STREAM_EXPANSIONS=author_id

# User fields (comma-separated)
# Options: created_at,description,entities,id,location,most_recent_tweet_id,
#          name,pinned_tweet_id,profile_image_url,protected,public_metrics,
#          url,username,verified,verified_type,withheld
STREAM_USER_FIELDS=name,username,profile_image_url,verified,verified_type

# Reconnect settings
# Max reconnection attempts before giving up
MAX_RECONNECT_ATTEMPTS=10

# Volume tracking
# Interval (ms) for checking post throughput (default: 60s)
VOLUME_TRACKING_INTERVAL_MS=60000
# Alert when volume drops by this percentage between windows
VOLUME_ALERT_THRESHOLD_PERCENT=50
